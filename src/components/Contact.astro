---
/**
 * Contacto como una conversación de Mensajes: quién habla está en la barra (una sola foto), la charla entra
 * en orden cuando la ventana aparece, y lo que escribís sale como globo y abre tu correo con el mensaje listo
 * (ver compose en scripts/windows.ts). La burbuja del cursor se corre mientras estás adentro (data-buddy-off).
 */
import { getImage } from 'astro:assets';
import Arrow from './Arrow.astro';
import SectionHead from './SectionHead.astro';
import avatar from '../assets/me/avatar.jpg';
import { langOf, pathIn, t } from '../i18n';

const lang = langOf(Astro.url);
const email = 'tomascardozo98@gmail.com';
const year = new Date().getFullYear();
const face = await getImage({ src: avatar, width: 56, format: 'webp', quality: 80 });
const links: [string, string, string][] = [
  ['Email', email, `mailto:${email}`],
  ['GitHub', 'manuxxaitos', 'https://github.com/manuxxaitos'],
  ['Behance', 'tomasecardozo', 'https://www.behance.net/tomasecardozo'],
  ['X', '@tomascardozo98', 'https://x.com/tomascardozo98'],
];
// la charla con la que arranca
const intro = ['¿Qué construimos?', 'Contame la idea, el producto o el proceso que querés sacarte de encima.'].map((s) => t(lang, s));
const langs = [
  { code: 'es', name: 'Español' },
  { code: 'en', name: 'English' },
] as const;
---

<section id="contacto" class="col sec" aria-labelledby="contacto-t">
  <SectionHead n={5} id="contacto-t" title={t(lang, 'Contacto')} />
  <div class="stage">
    <canvas data-plotter="field" aria-hidden="true"></canvas>
    <div class="chat glass" data-reveal data-buddy-off data-chat>
      <header class="chat__bar titlebar">
        <span class="lights" aria-hidden="true"><i class="light light--close"></i><i class="light light--min"></i><i class="light light--zoom"></i></span>
        <p class="chat__who titlebar__title">
          <img src={face.src} alt="" width="22" height="22" loading="lazy" decoding="async" />
          Tomás Cardozo
        </p>
        <span aria-hidden="true"></span>
      </header>
      <div class="chat__body">
        <ol class="thread" data-compose-log aria-live="polite">
          {
            intro.map((t) => (
              <li class="msg msg--in" data-intro>
                <p class="bubble">
                  <span class="sr-only">Tomás: </span>
                  {t}
                </p>
              </li>
            ))
          }
        </ol>
        <form class="compose" data-compose={email} action={`mailto:${email}`} method="post" enctype="text/plain">
          <label class="sr-only" for="compose-msg">{t(lang, 'Tu mensaje')}</label>
          <textarea id="compose-msg" name="mensaje" rows="1" placeholder={t(lang, 'Escribí tu mensaje…')} autocomplete="off"></textarea>
          <button class="aqua" type="submit" data-compose-send>{t(lang, 'Enviar')}</button>
        </form>
      </div>
      <footer class="chat__foot">
        <a href={`mailto:${email}`}>{email}</a>
        <button class="aqua aqua--graphite aqua--sm" type="button" data-copy={email}><span data-copy-label>{t(lang, 'Copiar')}</span></button>
      </footer>
    </div>
  </div>
</section>

<footer class="foot col">
  <dl class="foot__links">
    {
      links.map(([k, v, href]) => (
        <div>
          <dt>{k}</dt>
          <dd>
            <a
              href={href}
              rel={href.startsWith('http') ? 'me noopener' : undefined}
              target={href.startsWith('http') ? '_blank' : undefined}
            >
              {v}
            </a>
          </dd>
        </div>
      ))
    }
  </dl>
  <p class="foot__colophon">
    © {year} Tomás Cardozo. {t(lang, 'Tipografía Inter, de Rasmus Andersson. Hecho a mano en Astro, con un campo ASCII propio en WebGL.')}
    <span data-weight hidden> {t(lang, 'Esta visita pesó')} <span data-weight-kb></span>.</span>
  </p>
  <nav class="foot__lang" aria-label={t(lang, 'Idioma')}>
    {
      langs.map((l, i) => (
        <>
          {i > 0 && <span aria-hidden="true">/</span>}
          <a
            href={pathIn(l.code, Astro.url.pathname)}
            hreflang={l.code}
            lang={l.code}
            aria-label={l.name}
            aria-current={l.code === lang ? 'page' : undefined}
            data-say={l.code === lang ? undefined : l.code === 'en' ? 'Read it in English' : 'Leelo en español'}
          >
            {l.code.toUpperCase()}
          </a>
        </>
      ))
    }
  </nav>
  <a class="foot__top" href="#contenido">{t(lang, 'Arriba')} <Arrow dir="up" /></a>
</footer>

<style>
  /* el vidrio esmerila el campo ASCII que tiene detrás */
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(28px, 6vw, 64px) 0;
  }
  .stage canvas {
    -webkit-mask-image: radial-gradient(closest-side, #000 55%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 55%, transparent 100%);
  }
  .chat {
    position: relative;
    width: min(100%, 560px);
    border-radius: 16px;
    overflow: hidden;
  }
  /* barra: semáforos a la izquierda y, al medio, con quién hablás */
  .chat__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 48px;
    padding: 0 16px;
  }
  .chat__bar .light {
    width: 12px;
    height: 12px;
  }
  .chat__who {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .chat__who img {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    object-fit: cover;
    box-shadow:
      inset 0 0 0 0.5px rgb(18 19 20 / 0.2),
      0 1px 2px rgb(18 19 20 / 0.18);
  }
  .chat__body {
    padding: 26px 24px 24px;
  }

  /* la charla de entrada: aparece en orden cuando se ve la ventana (sin JS o con movimiento reducido, ya está) */
  :global(.js) .chat [data-intro] > .bubble {
    opacity: 0;
  }
  :global(.js) .chat [data-intro].is-in > .bubble {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .chat [data-intro] > .bubble {
      opacity: 1;
    }
  }
  /* mientras escribo la siguiente, los puntitos ocupan su lugar (no se mueve nada) */
  .chat [data-intro] {
    position: relative;
  }
  .chat :global(.typing--ghost) {
    position: absolute;
    left: 0;
    top: 0;
  }

  .compose {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    margin-top: 26px;
    padding: 6px 6px 6px 18px;
    border-radius: 24px;
    background: rgb(255 255 255 / 0.85);
    box-shadow:
      inset 0 1px 3px rgb(18 19 20 / 0.14),
      inset 0 0 0 1px rgb(18 19 20 / 0.1);
  }
  /* validación: borde cálido mientras dice qué falta */
  .compose:global(.is-error),
  .compose:global(.is-error):focus-within {
    box-shadow:
      inset 0 1px 3px rgb(18 19 20 / 0.14),
      inset 0 0 0 1px rgb(214 72 44 / 0.7),
      0 0 0 3px rgb(255 96 64 / 0.2);
  }
  .compose:global(.is-error) textarea::placeholder {
    color: #b8401f;
  }
  .compose:focus-within {
    box-shadow:
      inset 0 1px 3px rgb(18 19 20 / 0.14),
      inset 0 0 0 1px rgb(30 120 240 / 0.6),
      0 0 0 3px rgb(60 150 255 / 0.25);
  }
  textarea {
    flex: 1;
    min-height: 32px;
    max-height: 160px;
    padding: 6px 0;
    border: 0;
    outline: 0;
    resize: none;
    background: none;
    font: inherit;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--ink);
  }
  textarea::placeholder {
    color: var(--ink-3);
  }
  .compose .aqua {
    height: 32px;
    padding: 0 18px;
  }

  /* pie de la ventana: el mail a mano, para copiarlo */
  .chat__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px 18px 12px 24px;
    border-top: 1px solid rgb(18 19 20 / 0.07);
    background: rgb(250 250 248 / 0.55);
    font-size: 0.8125rem;
  }
  .chat__foot a {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-2);
    text-decoration: none;
  }
  .chat__foot a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  @media (max-width: 560px) {
    .chat__body {
      padding: 22px 18px 20px;
    }
    .chat__foot {
      padding-left: 18px;
    }
  }

  .foot {
    padding-top: clamp(48px, 8vh, 88px);
    padding-bottom: 40px;
    font-size: 0.875rem;
  }
  .foot__links {
    max-width: 360px;
  }
  .foot__links div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
  }
  .foot__links dt {
    color: var(--ink-3);
  }
  .foot__links a {
    text-decoration: none;
  }
  .foot__links a:hover {
    text-decoration: underline;
  }
  .foot__colophon {
    max-width: 60ch;
    margin-top: 28px;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .foot__lang {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .foot__lang a {
    color: var(--ink-3);
    text-decoration: none;
  }
  .foot__lang a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .foot__lang a[aria-current] {
    color: var(--ink);
    font-weight: 600;
  }
  .foot__top {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-decoration: none;
  }
  .foot__top :global(svg) {
    width: 11px;
    height: 11px;
  }
</style>
