---
/**
 * Ventana de vidrio con la galería de un proyecto: se abre sobre la página
 * desde su tarjeta (efecto genio), sin página propia. Los semáforos cierran
 * o agrandan; las flechas pasan al proyecto vecino. Mientras está abierta,
 * la burbuja del cursor cuenta el proyecto (data-says) y nombra cada pieza
 * al pasar (data-say). Ver scripts/windows.ts y scripts/buddy.ts.
 */
import Media from './Media.astro';
import Arrow from './Arrow.astro';
import Soportes from './Soportes.astro';
import type { Item, Project } from '../data/types';
import { langOf, t } from '../i18n';

interface Props {
  p: Project;
  prev: Project;
  next: Project;
}
const lang = langOf(Astro.url);
const { p, prev, next } = Astro.props;
const id = p.slug;
const sizesFor = (span = 12) => `(min-width: 1100px) ${Math.round((span / 12) * 1100)}px, (min-width: 820px) ${Math.round((span / 12) * 90)}vw, 100vw`;
const cells = (items: Item[]) => items.map((m) => ({ m, span: m.span ?? 12 }));
/* lo que dice la burbuja sobre cada pieza: su descripción, otra frase, o nada si la pieza ya lo dice sola
   (los visores 3D y las tarjetas tienen su propia burbuja adentro) */
const captionOf = (m: Item) => {
  if (m.say === false || m.kind === 'toy' || m.kind === 'tilt' || m.kind === 'stack') return undefined;
  if (m.say) return m.say;
  return m.kind === 'image' ? m.alt : m.kind === 'loop' ? m.label : undefined;
};
---

<dialog class="win" id={id} data-win={p.slug} data-says={JSON.stringify(p.says ?? [])} aria-labelledby={`${id}-t`}>
  <div class="win__frame glass" data-win-frame>
    <header class="win__bar titlebar">
      <div class="lights">
        <button class="light light--close" type="button" data-win-close aria-label={t(lang, 'Cerrar')}>
          <svg viewBox="0 0 8 8" aria-hidden="true"><path d="M1.5 1.5l5 5M6.5 1.5l-5 5"></path></svg>
        </button>
        <button class="light light--min" type="button" data-win-close aria-label={t(lang, 'Minimizar')}>
          <svg viewBox="0 0 8 8" aria-hidden="true"><path d="M1.2 4h5.6"></path></svg>
        </button>
        <button class="light light--zoom" type="button" data-win-zoom aria-label={t(lang, 'Agrandar')}>
          <svg viewBox="0 0 8 8" aria-hidden="true"><path d="M4 1.2v5.6M1.2 4h5.6"></path></svg>
        </button>
      </div>
      <h2 class="win__title titlebar__title" id={`${id}-t`}>
        {p.title} <span class="win__what">— {p.what} · {p.year}</span>
      </h2>
      <div class="win__tools">
        <div class="seg" role="group" aria-label={t(lang, 'Otros proyectos')}>
          <button
            class="aqua aqua--graphite aqua--sm"
            type="button"
            data-win-go={prev.slug}
            aria-label={`${t(lang, 'Anterior')}: ${prev.title}`}
            data-say={`${t(lang, 'Anterior')}: ${prev.title}`}
          >
            <Arrow dir="left" />
          </button>
          <button
            class="aqua aqua--graphite aqua--sm"
            type="button"
            data-win-go={next.slug}
            aria-label={`${t(lang, 'Siguiente')}: ${next.title}`}
            data-say={`${t(lang, 'Siguiente')}: ${next.title}`}
          >
            <Arrow />
          </button>
        </div>
        {
          p.url && (
            <a class="aqua aqua--sm aqua--pulse" href={p.url.href} target="_blank" rel="noopener">
              {t(lang, 'Ver sitio')} <Arrow dir="up-right" />
            </a>
          )
        }
      </div>
    </header>

    <div class="win__body" data-win-body data-lenis-prevent>
      <p class="win__line">
        {p.line}
        {p.note && <span class="win__note">{p.note}</span>}
      </p>
      {
        p.gallery && (
          <div class="grid">
            {cells(p.gallery).map(({ m, span }) => (
              <figure class="cell" style={`--span:${span}`} data-say={captionOf(m)}>
                <Media item={m} interactive sizes={sizesFor(span)} />
              </figure>
            ))}
          </div>
        )
      }
      {
        p.groups?.map((g) =>
          g.stage ? (
            <Soportes title={g.title} stage={g.stage} />
          ) : (
            <section class="group" aria-label={g.title}>
              <header class="group__head">
                <h3>{g.title}</h3>
                {g.text && (
                  <p>
                    <span class="muted">{g.client}.</span> {g.text}
                  </p>
                )}
              </header>
              <div class="grid">
                {cells(g.items ?? []).map(({ m, span }) => (
                  <figure class="cell" style={`--span:${span}`} data-say={captionOf(m)}>
                    <Media item={m} sizes={sizesFor(span)} />
                  </figure>
                ))}
              </div>
            </section>
          ),
        )
      }
    </div>
  </div>
</dialog>

<style>
  .win {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(10px, 3vh, 36px) clamp(10px, 3vw, 40px);
    border: 0;
    background: none;
    overflow: hidden;
  }
  .win[open] {
    display: grid;
    place-items: center;
  }
  .win::backdrop {
    background: rgb(52 54 58 / 0.24);
    -webkit-backdrop-filter: blur(8px) saturate(1.3);
    backdrop-filter: blur(8px) saturate(1.3);
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }
  .win.is-open::backdrop {
    opacity: 1;
  }
  .win__frame {
    display: flex;
    flex-direction: column;
    width: min(100%, 1180px);
    height: min(100%, 900px);
    border-radius: 14px;
    overflow: hidden;
    transition:
      width 0.5s var(--ease-out),
      height 0.5s var(--ease-out);
  }
  /* el semáforo verde la lleva a toda la pantalla */
  .win.is-max .win__frame {
    width: 100%;
    height: 100%;
  }

  .win__bar {
    flex: none;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    height: 46px;
    padding: 0 12px 0 16px;
  }
  .win__title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
  }
  .win__what {
    font-weight: 450;
    color: var(--ink-3);
  }
  .win__tools {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
  }
  .seg {
    display: flex;
  }
  .seg .aqua {
    width: 30px;
    padding: 0;
  }
  .seg .aqua:first-child {
    border-radius: 999px 0 0 999px;
  }
  .seg .aqua:last-child {
    margin-left: -1px;
    border-radius: 0 999px 999px 0;
  }
  .seg :global(svg) {
    width: 11px;
    height: 11px;
  }

  .win__body {
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding: clamp(14px, 2vw, 24px);
    background: rgb(250 250 248 / 0.8);
  }
  /* una línea de contexto para todos (en táctil no hay burbuja) */
  .win__line {
    max-width: 62ch;
    margin: 2px 2px 16px;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  .win__note {
    display: block;
    margin-top: 2px;
    font-size: 0.8125rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
  }
  .cell {
    grid-column: span var(--span);
  }
  .cell :global(.media--natural) {
    border-radius: 10px;
  }
  .group + .group {
    margin-top: 40px;
  }
  .group__head {
    max-width: 60ch;
    margin-bottom: 14px;
  }
  .group__head h3 {
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
  }
  .group__head p {
    margin-top: 4px;
    color: var(--ink-2);
  }

  @media (max-width: 820px) {
    .win {
      padding: 8px;
    }
    .win__frame {
      height: 100%;
    }
    .win__bar {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 10px;
      padding: 0 10px 0 12px;
    }
    .win__title {
      text-align: left;
    }
    .win__what,
    .seg {
      display: none;
    }
    /* las piezas chicas van de a dos; el resto, a lo ancho */
    .cell {
      grid-column: span calc(6 + 6 * clamp(0, var(--span) - 4, 1));
    }
  }

  /* sin JS: la ventana se abre con el ancla */
  :global(html:not(.js)) .win:target {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
  }
</style>
