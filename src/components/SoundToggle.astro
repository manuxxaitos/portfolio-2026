---
/**
 * Botón para activar o silenciar los sonidos de la página (scripts/sound.ts). Viene prendido y
 * recuerda si lo apagaste. La lucecita verde dice si está prendido.
 */
---

<button class="snd aqua aqua--graphite aqua--sm" type="button" data-sound-toggle aria-pressed="true" data-say="Silenciar">
  <svg class="snd__icon" viewBox="0 0 16 16" aria-hidden="true">
    <path class="snd__body" d="M2.4 6.1h2.3L8 3.3v9.4l-3.3-2.8H2.4z"></path>
    <path class="snd__wave" d="M10.3 5.7a3.3 3.3 0 0 1 0 4.6M12.1 4a5.7 5.7 0 0 1 0 8"></path>
    <path class="snd__off" d="M10.6 6.2l3.4 3.6M14 6.2l-3.4 3.6"></path>
  </svg>
  <span class="snd__label">Sonido</span>
  <i class="snd__led" aria-hidden="true"></i>
</button>

<style>
  .snd {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 60;
    gap: 6px;
    padding: 0 10px 0 9px;
  }
  .snd__icon {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .snd__body {
    fill: currentColor;
    stroke: none;
  }
  .snd[aria-pressed='false'] .snd__wave,
  .snd[aria-pressed='true'] .snd__off {
    display: none;
  }
  .snd__led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 35%, #e3e5e8, #9a9ea3);
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.3);
    transition:
      background 0.3s,
      box-shadow 0.3s;
  }
  .snd[aria-pressed='true'] .snd__led {
    background: radial-gradient(circle at 50% 35%, #e0fff0, #3fd08a 60%, #1b9a5e);
    box-shadow:
      0 0 6px rgb(60 210 140 / 0.8),
      inset 0 0 0 0.5px rgb(0 80 40 / 0.4);
  }
  /* en el teléfono, solo el ícono y la luz */
  @media (max-width: 560px) {
    .snd__label {
      display: none;
    }
  }
</style>
